# Normaliza finales de línea entre Windows y Linux (en el repo siempre LF).
* text=auto

# Código y assets de Unity serializados como texto (Force Text).
*.cs        text diff=csharp
*.asmdef    text
*.json      text
*.md        text
*.meta      text
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.anim      text
*.controller text
*.uss       text
*.uxml      text

# Binarios: nunca tocar finales de línea ni intentar hacer diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.tga  binary
*.gif  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.fbx  binary
